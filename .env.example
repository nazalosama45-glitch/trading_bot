# Copy this to .env and fill in your keys
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here

# Use Binance testnet (free fake money) — get keys at testnet.binance.vision
USE_TESTNET=false

# SAFETY: Set to "true" to simulate trades without real money
DRY_RUN=true

# Trading pairs (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT

# Risk settings
MAX_POSITION_PCT=0.02        # Max 2% of portfolio per trade
DAILY_LOSS_LIMIT_PCT=0.05    # Stop trading if down 5% in a day
MAX_OPEN_POSITIONS=3

# Timeframe for candles
TIMEFRAME=15m
